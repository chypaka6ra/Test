# Telegram Bot Configuration
# ВАЖНО: Скопируйте этот файл в .env и заполните реальные значения
# ВАЖНО: НЕ коммитьте .env в Git!

# Ваш Telegram Bot Token (получите у @BotFather)
# Формат: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID вашего Telegram чата или пользователя
# Найдите свой ID с помощью @userinfobot
TELEGRAM_CHAT_ID=780759394

# Среда выполнения
NODE_ENV=production

# Порт сервера
PORT=3000

# URL фронтенда (для CORS)
FRONTEND_URL=http://localhost:8000

# Логирование
LOG_LEVEL=info
